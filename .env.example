# ============ 复制为 .env 后填写 ============

# --- 大模型（任意 OpenAI 兼容端点） ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.6
# LLM_MAX_TOKENS=8000   # 成稿全文 JSON 实测 8k+ token，若日志报「输出被截断/JSON 括号不闭合」请调大（如 16000）
# LLM_TRUST_ENV=0       # 内网网关被公司上网代理劫持时设 0 直连；公网端点保持默认 1
# LLM_REASONING_EFFORT=none   # 推理模型（DeepSeek-R1/V4 等）建议关思考：思维链与正文共享
                              # max_tokens，不关会「返回为空 / JSON 截断 / 单篇数分钟」。
                              # 留空则不下发该参数，非推理模型无需设置。

# --- 微信公众号（服务号/订阅号，需有「草稿箱」接口权限：认证订阅号或服务号） ---
WX_APPID=
WX_SECRET=
WX_AUTHOR=底层视觉论文笔记
# 封面临时素材 media_id（可不填，系统会自动上传 out 里的封面）
WX_THUMB_MEDIA_ID=
# 生成后是否自动推草稿箱（默认 false，出稿后手动在控制台点「推草稿」）
WX_AUTO_PUBLISH=false
# 发布属性（硬默认，每次推草稿必带；改这里即可，代码里不写第二份）
WX_ORIGINAL_TYPE=文字原创    # 可选：文字原创 / 图片原创 / 视频原创 / 不声明原创
WX_COLLECTION=每日推送
# 微信 draft/add 没有原创与合集字段（官方明确不支持），默认不写进 payload；
# 接口将来开放或走第三方代调用通道时置 1 即可原样下发。
WX_DRAFT_EXTRA_FIELDS=0
# 推完草稿后用 Playwright 回后台自动勾「文字原创」+ 选合集（需要已登录态）
WX_UI_FILL=0
# playwright storage_state 导出文件路径（不填则每次都要扫码，UI 自动化会跳过）
WX_STORAGE_STATE=

# --- 运行 ---
# 强制离线演示模式（不调模型，用占位稿）
LLCV_MOCK_LLM=false
LLCV_OUT=./out
LLCV_DB=./data/llcv.db
TZ_NAME=Asia/Shanghai
LLCV_HOST=127.0.0.1
LLCV_PORT=8000
# 设置后，触发出稿/推送接口必须带 X-Admin-Token 头
LLCV_ADMIN_TOKEN=

# --- 可选：竞赛检索 ---
KAGGLE_USERNAME=
KAGGLE_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
