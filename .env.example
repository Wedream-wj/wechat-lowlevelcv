# ============ 复制为 .env 后填写 ============

# --- 大模型（任意 OpenAI 兼容端点） ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.6
# LLM_MAX_TOKENS=8000

# --- 微信公众号（服务号/订阅号，需有「草稿箱」接口权限：认证订阅号或服务号） ---
WX_APPID=
WX_SECRET=
WX_AUTHOR=底层视觉论文笔记
# 封面临时素材 media_id（可不填，系统会自动上传 out 里的封面）
WX_THUMB_MEDIA_ID=
# 生成后是否自动推草稿箱（默认 false，出稿后手动在控制台点「推草稿」）
WX_AUTO_PUBLISH=false

# --- 运行 ---
# 强制离线演示模式（不调模型，用占位稿）
LLCV_MOCK_LLM=false
LLCV_OUT=./out
LLCV_DB=./data/llcv.db
TZ_NAME=Asia/Shanghai
LLCV_HOST=127.0.0.1
LLCV_PORT=8000
# 设置后，触发出稿/推送接口必须带 X-Admin-Token 头
LLCV_ADMIN_TOKEN=

# --- 可选：竞赛检索 ---
KAGGLE_USERNAME=
KAGGLE_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
